{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nomad",
  "version": "1.1.0",
  "identifier": "com.nomad.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nomad",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Amanfor/nomad/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzQjg3NUZCODQ5OTU2MjgKUldRb1ZwbUUrM1c0NDlGaWdiMnltU3UzQ1hPNkxkRW9sYWtMdFRFenpJNDNqN3ArQ215VkNFNkwK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "JEE Main study guide",
    "longDescription": "A minimal offline-first guide for JEE Main preparation: practice, PYQs, formula sheets and concepts.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
