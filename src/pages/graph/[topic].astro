---
import Base from '../../layouts/Base.astro'
import ConceptGraph from '../../components/ConceptGraph.tsx'
import fs from 'node:fs'
import path from 'node:path'

export function getStaticPaths() {
  const dir = path.resolve('public/graph');
  if (!fs.existsSync(dir)) return [];
  return fs
    .readdirSync(dir)
    .filter((f) => f.endsWith('.json'))
    .map((f) => ({ params: { topic: f.replace(/\.json$/, '') } }));
}
---
<Base title={`nomad · ${Astro.params.topic}`}>
  <ConceptGraph client:only="react" topic={Astro.params.topic} />
</Base>
